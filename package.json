{
  "name": "api-to-mcp-generator",
  "version": "2.0.0.0",
  "description": "Protocol-aware OpenAPI normalization compiler that generates deterministic MCP servers from real-world API specs",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.6.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^1.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.7"
  },
  "vitest": {
    "include": [
      "tests/**/*.test.ts"
    ],
    "coverage": {
      "provider": "v8",
      "include": [
        "src/**/*.ts"
      ],
      "thresholds": {
        "lines": 80
      }
    }
  }
}
