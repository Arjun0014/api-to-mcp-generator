{
  "name": "api-to-mcp-generator",
  "version": "1.0.0",
  "description": "Protocol-aware OpenAPI normalization compiler that generates deterministic MCP servers from real-world API specs",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@apidevtools/swagger-parser": "^10.1.0",
    "zod": "^3.22.0",
    "axios": "^1.6.0",
    "prettier": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "ts-node": "^10.9.0",
    "@vitest/coverage-v8": "^1.2.0"
  },
  "vitest": {
    "include": ["tests/**/*.test.ts"],
    "coverage": {
      "provider": "v8",
      "include": ["src/**/*.ts"],
      "thresholds": { "lines": 80 }
    }
  }
}
